@implements IDisposable
@inject AuthState Auth
@inject ApiClient Api
@inject Loc L
@inject NavigationManager Nav

<header class="zk-nav">
    <div class="zk-nav-inner">
        <BrandLogo Href="" Size="38" />

        <nav id="zk-mobile-nav" class="zk-nav-links @(menuOpen ? "open" : null)" @onclick="CloseMenu" aria-label="@L["nav.primary"]">
            <NavLink href="" Match="NavLinkMatch.All">@L["nav.home"]</NavLink>
            <NavLink href="listings">@L["nav.listings"]</NavLink>
            <NavLink href="bookings">@L["nav.bookings"]</NavLink>
            <NavLink href="wallet">@L["nav.wallet"]</NavLink>
        </nav>

        <div class="zk-nav-cta">
            <button class="zk-lang" @onclick="SwitchLang" title="@L["lang.switchTo"]" aria-label="@L["lang.switchTo"]">
                <i class="ti ti-world" aria-hidden="true"></i> <span class="zk-lang-txt">@L["lang.switchTo"]</span>
            </button>

            @if (Auth.IsAuthenticated)
            {
                <a href="wallet" class="zk-balance-pill" title="@L["nav.wallet"]">
                    @if (balance is decimal b)
                    {
                        <ZkAmount Amount="b" />
                    }
                    else
                    {
                        <span>— ZK</span>
                    }
                </a>
                <div class="zk-nav-user">
                    <span class="zk-nav-avatar">@Initials</span>
                    <button class="zk-btn zk-btn-ghost zk-btn-sm" @onclick="Logout">@L["nav.logout"]</button>
                </div>
            }
            else
            {
                <a href="login" class="zk-btn zk-btn-primary zk-btn-sm">@L["nav.login"]</a>
            }

            <button class="zk-nav-toggle" @onclick="ToggleMenu" aria-label="@L["nav.menu"]" aria-expanded="@(menuOpen ? "true" : "false")" aria-controls="zk-mobile-nav">
                <i class="ti @(menuOpen ? "ti-x" : "ti-menu-2")" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</header>

@code {
    private decimal? balance;
    private bool menuOpen;

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnAuthChanged;
        await Auth.EnsureLoadedAsync();
        await LoadBalance();
    }

    private void OnAuthChanged() => InvokeAsync(async () =>
    {
        await LoadBalance();
        StateHasChanged();
    });

    private async Task LoadBalance()
    {
        if (!Auth.IsAuthenticated) { balance = null; return; }
        try { balance = (await Api.GetWalletAsync())?.Balance; }
        catch { balance = null; }
    }

    private void SwitchLang()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri);
        var redirect = "/" + rel;
        var url = $"/Culture/Set?culture={L.OtherLang}&redirectUri={Uri.EscapeDataString(redirect)}";
        Nav.NavigateTo(url, forceLoad: true); // tam yeniden yükleme -> kültür tazelenir
    }

    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;

    private async Task Logout() => await Auth.SignOutAsync();

    private string Initials
    {
        get
        {
            var name = Auth.DisplayName;
            if (string.IsNullOrWhiteSpace(name)) return "?";
            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length >= 2
                ? $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}"
                : char.ToUpper(name[0]).ToString();
        }
    }

    public void Dispose() => Auth.Changed -= OnAuthChanged;
}
