@* Parola alanı + göster/gizle düğmesi. Kullanım: <PasswordInput @bind-Value="password" OnEnter="Submit" /> *@
@inject Loc L

<div class="zk-pw">
    <input class="form-control" type="@(show ? "text" : "password")" value="@Value" @oninput="OnInput" @onkeydown="OnKeyDown"
           placeholder="@Placeholder" autocomplete="@AutoComplete" />
    <button type="button" class="zk-pw-toggle" @onclick="() => show = !show"
            aria-label="@(show ? L["auth.hidePassword"] : L["auth.showPassword"])" title="@(show ? L["auth.hidePassword"] : L["auth.showPassword"])">
        <i class="ti @(show ? "ti-eye-off" : "ti-eye")"></i>
    </button>
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback OnEnter { get; set; }
    [Parameter] public string Placeholder { get; set; } = "••••••••";
    /// <summary>"current-password" (giriş) ya da "new-password" (kayıt/sıfırlama) — tarayıcı parola yöneticileri için.</summary>
    [Parameter] public string AutoComplete { get; set; } = "current-password";

    private bool show;

    private Task OnInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && OnEnter.HasDelegate) await OnEnter.InvokeAsync();
    }
}
