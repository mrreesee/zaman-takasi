@page "/forgot-password"
@inject ApiClient Api
@inject Loc L

<PageTitle>@L["auth.forgot.title"] — Zaman Takası</PageTitle>

<div class="zk-auth-wrap">
    <div class="zk-auth-card">
        <div class="zk-auth-head">
            <BrandLogo Href="" Size="46" ShowText="false" />
            <h1>@L["auth.forgot.title"]</h1>
            <p>@L["auth.forgot.sub"]</p>
        </div>

        @if (sent)
        {
            <div class="alert alert-success zk-mt"><i class="ti ti-mail-check"></i> @L["auth.forgot.sent"]</div>
        }
        else
        {
            <div class="zk-field">
                <label>@L["auth.email"]</label>
                <input class="form-control" type="email" @bind="email" @bind:event="oninput" @onkeydown="OnKey" placeholder="@L["auth.emailPlaceholder"]" />
            </div>

            <button class="zk-btn zk-btn-primary zk-block" @onclick="Submit" disabled="@(busy || string.IsNullOrWhiteSpace(email))">
                @if (busy) { <span>@L["auth.forgot.submitting"]</span> } else { <span><i class="ti ti-mail-forward"></i> @L["auth.forgot.submit"]</span> }
            </button>

            @if (error is not null) { <div class="alert alert-danger zk-mt">@error</div> }
        }

        <div class="zk-auth-foot"><a href="login">@L["auth.forgot.backToLogin"]</a></div>
    </div>
</div>

@code {
    private string email = "";
    private string? error;
    private bool busy;
    private bool sent;

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(email)) return;
        error = null; busy = true;
        try
        {
            await Api.ForgotPasswordAsync(new ForgotPasswordRequest(email.Trim(), L.Lang));
            sent = true; // API her durumda 200 döner (hesap varlığını sızdırmaz)
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
