@page "/reset-password"
@inject ApiClient Api
@inject Loc L

<PageTitle>@L["auth.reset.title"] — Zaman Takası</PageTitle>

<div class="zk-auth-wrap">
    <div class="zk-auth-card">
        <div class="zk-auth-head">
            <BrandLogo Href="" Size="46" ShowText="false" />
            <h1>@L["auth.reset.title"]</h1>
            <p>@L["auth.reset.sub"]</p>
        </div>

        @if (!LinkValid)
        {
            <div class="alert alert-danger zk-mt">@L["auth.reset.invalidLink"]</div>
            <div class="zk-auth-foot"><a href="forgot-password">@L["auth.reset.requestNew"]</a></div>
        }
        else if (done)
        {
            <div class="alert alert-success zk-mt"><i class="ti ti-circle-check"></i> @L["auth.reset.success"]</div>
            <a class="zk-btn zk-btn-primary zk-block zk-mt" href="login"><i class="ti ti-login-2"></i> @L["auth.login.submit"]</a>
        }
        else
        {
            <div class="zk-field">
                <label>@L["auth.reset.newPassword"]</label>
                <PasswordInput @bind-Value="password" AutoComplete="new-password" />
                <small style="display:block; margin-top:6px; color:var(--zk-muted); font-size:12.5px;">
                    <i class="ti ti-info-circle"></i> @L["auth.passwordHint"]
                </small>
            </div>
            <div class="zk-field">
                <label>@L["auth.reset.confirmPassword"]</label>
                <PasswordInput @bind-Value="confirm" OnEnter="Submit" AutoComplete="new-password" />
            </div>

            <button class="zk-btn zk-btn-primary zk-block" @onclick="Submit" disabled="@busy">
                @if (busy) { <span>@L["auth.reset.submitting"]</span> } else { <span><i class="ti ti-key"></i> @L["auth.reset.submit"]</span> }
            </button>

            @if (error is not null) { <div class="alert alert-danger zk-mt">@error</div> }

            <div class="zk-auth-foot"><a href="login">@L["auth.forgot.backToLogin"]</a></div>
        }
    </div>
</div>

@code {
    [Parameter, SupplyParameterFromQuery] public string? UserId { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? Token { get; set; }

    private string password = "";
    private string confirm = "";
    private string? error;
    private bool busy;
    private bool done;

    private bool LinkValid => Guid.TryParse(UserId, out _) && !string.IsNullOrWhiteSpace(Token);

    private async Task Submit()
    {
        if (busy) return;
        error = null;
        if (password != confirm) { error = L["auth.reset.mismatch"]; return; }

        busy = true;
        try
        {
            await Api.ResetPasswordAsync(new ResetPasswordRequest(Guid.Parse(UserId!), Token!, password));
            done = true;
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
