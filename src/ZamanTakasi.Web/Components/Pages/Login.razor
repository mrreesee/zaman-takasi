@page "/login"
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject Loc L

<PageTitle>@L["auth.login.submit"] — Zaman Takası</PageTitle>

<div class="zk-auth-wrap">
    <div class="zk-auth-card">
        <div class="zk-auth-head">
            <BrandLogo Href="" Size="46" ShowText="false" />
            <h1>@L["auth.login.welcome"]</h1>
            <p>@L["auth.login.sub"]</p>
        </div>

        <div class="zk-field">
            <label>@L["auth.email"]</label>
            <input class="form-control" type="email" @bind="email" @bind:event="oninput" placeholder="@L["auth.emailPlaceholder"]" />
        </div>
        <div class="zk-field">
            <label>@L["auth.password"]</label>
            <input class="form-control" type="password" @bind="password" @bind:event="oninput" @onkeydown="OnKey" placeholder="••••••••" />
        </div>

        <button class="zk-btn zk-btn-primary zk-block" @onclick="Submit" disabled="@busy">
            @if (busy) { <span>@L["auth.login.submitting"]</span> } else { <span><i class="ti ti-login-2"></i> @L["auth.login.submit"]</span> }
        </button>

        @if (error is not null) { <div class="alert alert-danger zk-mt">@error</div> }

        @if (showResend)
        {
            <div class="alert alert-warning zk-mt">
                <div>@L["auth.confirm.needed"]</div>
                @if (resendSent)
                {
                    <div class="zk-mt"><i class="ti ti-mail-check"></i> @L["auth.confirm.resent"]</div>
                }
                else
                {
                    <button class="zk-btn zk-block zk-mt" @onclick="Resend" disabled="@busy">
                        <i class="ti ti-mail-forward"></i> @L["auth.confirm.resend"]
                    </button>
                }
            </div>
        }

        <div class="zk-auth-foot">
            <a href="forgot-password">@L["auth.login.forgot"]</a>
            <span style="margin:0 8px; opacity:.5;">·</span>
            @L["auth.login.noAccount"] <a href="register">@L["nav.register"]</a>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string? error;
    private bool busy;
    private bool showResend;
    private bool resendSent;

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }

    private async Task Submit()
    {
        error = null; showResend = false; resendSent = false; busy = true;
        try
        {
            var resp = await Api.LoginAsync(new LoginRequest(email, password));
            await Auth.SignInAsync(resp!);
            Nav.NavigateTo("/listings");
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            // 403 = e-posta doğrulanmamış (katı kapı açık). Kullanıcıya "tekrar gönder" sun.
            if (ex.StatusCode == 403) showResend = true;
        }
        finally { busy = false; }
    }

    private async Task Resend()
    {
        busy = true;
        try
        {
            await Api.ResendConfirmationAsync(new ResendConfirmationRequest(email, L.Lang));
            resendSent = true; // cevap her zaman 200 (hesap varlığını sızdırmaz)
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
